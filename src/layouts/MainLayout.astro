---
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import config from "../config.json";
import "../styles/global.css";

const { title: subtitle, description } = Astro.props as {
    title?: string;
    description?: string;
};

const title = subtitle
    ? `${subtitle} &bull; ${config.page_title}`
    : config.page_title;
---

<html lang="en">
    <head>
        <!-- Page Metadata -->
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
        />
        <meta name="description" content={description ?? config.description} />
        <title>{title}</title>
        <!-- Page Resources -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        />
        <script is:inline>
            (() => {
                try {
                    const root = document.documentElement;
                    if (localStorage.getItem("glitched-clouds") === "off") root.classList.add("clouds-off");
                    if (localStorage.getItem("glitched-animations") === "off") root.classList.add("animations-off");
                } catch {}
            })();
        </script>
    </head>
    <body class="w-full min-h-screen">
        <NavBar />
        <slot />
        <Footer />
        <aside class="performance-controls" aria-label="Visual settings">
            <button class="performance-controls-tab" type="button" aria-expanded="false" aria-controls="performance-controls-panel">
                Settings
            </button>
            <div id="performance-controls-panel" class="performance-controls-panel" hidden>
                <p class="performance-controls-title font-PressStart2P">Visuals</p>
                <label>
                    <span>Clouds</span>
                    <input id="clouds-toggle" type="checkbox" checked />
                </label>
                <label>
                    <span>Animations</span>
                    <input id="animations-toggle" type="checkbox" checked />
                </label>
            </div>
        </aside>
        <script is:inline>
            (() => {
                const root = document.documentElement;
                const controls = document.querySelector(".performance-controls");
                const tab = document.querySelector(".performance-controls-tab");
                const panel = document.getElementById("performance-controls-panel");
                const cloudsToggle = document.getElementById("clouds-toggle");
                const animationsToggle = document.getElementById("animations-toggle");
                if (!controls || !tab || !panel || !cloudsToggle || !animationsToggle) return;

                const setStored = (key, enabled) => {
                    try {
                        localStorage.setItem(key, enabled ? "on" : "off");
                    } catch {}
                };

                const sync = () => {
                    cloudsToggle.checked = !root.classList.contains("clouds-off");
                    animationsToggle.checked = !root.classList.contains("animations-off");
                };

                tab.addEventListener("click", () => {
                    const isOpen = controls.classList.toggle("is-open");
                    tab.setAttribute("aria-expanded", String(isOpen));
                    panel.hidden = !isOpen;
                });

                cloudsToggle.addEventListener("change", () => {
                    root.classList.toggle("clouds-off", !cloudsToggle.checked);
                    setStored("glitched-clouds", cloudsToggle.checked);
                    window.dispatchEvent(new CustomEvent("glitched-settings-change"));
                });

                animationsToggle.addEventListener("change", () => {
                    root.classList.toggle("animations-off", !animationsToggle.checked);
                    setStored("glitched-animations", animationsToggle.checked);
                    window.dispatchEvent(new CustomEvent("glitched-settings-change"));
                });

                sync();
            })();
        </script>
        <script is:inline>
            (() => {
                const staffGrid = document.querySelector(".staff-section .mt-8.grid");
                if (staffGrid && !staffGrid.dataset.splitStaff) {
                    const avatarPixels = [
                        "#2b2417", "#211b12", "#2d2617", "#403019", "#51361e", "#50351f", "#3b2a1b", "#2b2417",
                        "#8d6248", "#c29072", "#c99b80", "#d1a18a", "#c58f73", "#bd8769", "#b77e61", "#8a5d43",
                        "#bc8766", "#c18d70", "#be8b72", "#a87860", "#8f6652", "#b77f63", "#bd8764", "#ae795b",
                        "#ffffff", "#ffffff", "#4b3aa0", "#c89376", "#b77c62", "#5541a8", "#ffffff", "#ffffff",
                        "#a8704f", "#b57b5e", "#b98269", "#6f4938", "#704838", "#b47a5e", "#a66b4d", "#9a6548",
                        "#a56746", "#9a5e3f", "#3a2115", "#6f4438", "#9b5b4d", "#3a2115", "#9c6042", "#8a563c",
                        "#6b3f2b", "#6b3f2b", "#321d13", "#8e5144", "#9b5b4d", "#321d13", "#6b3f2b", "#6b3f2b",
                        "#2b180f", "#2b180f", "#2b180f", "#2d190f", "#2d190f", "#2b180f", "#2b180f", "#2b180f"
                    ];
                    const staffBios = {
                        Plumbaskett: "The strongest master baiter of all time.",
                        Yzopontop: "Hi I am yzopontop, and here to help you out."
                    };
                    const avatarMarkup = `<div class="staff-avatar" aria-hidden="true">${avatarPixels
                        .map((color) => `<i style="--c:${color}"></i>`)
                        .join("")}</div>`;
                    const personCards = [];
                    staffGrid.querySelectorAll(".staff-card").forEach((card) => {
                        const role = card.querySelector("h3")?.textContent?.trim() || "Staff";
                        card.querySelectorAll("span").forEach((member) => {
                            const name = member.textContent?.trim();
                            if (!name) return;

                            const bio = staffBios[name] || "placeholder";
                            const personCard = document.createElement("article");
                            personCard.className = card.className;
                            personCard.dataset.role = role;
                            personCard.innerHTML = `
                                ${avatarMarkup}
                                <h3 class="text-lg font-PressStart2P">${name}</h3>
                                <div class="mt-4 flex flex-wrap gap-2">
                                    <span class="border border-white/20 bg-white/10 px-3 py-1 text-sm text-white/88">${role}</span>
                                </div>
                                <p class="mt-4 leading-7 text-white/68">${bio}</p>
                            `;
                            personCards.push(personCard);
                        });
                    });

                    if (personCards.length) {
                        staffGrid.replaceChildren(...personCards);
                        staffGrid.dataset.splitStaff = "true";
                    }
                }

                const page = document.querySelector(".updates-page");
                if (!page) return;

                const sectionNames = new Set([
                    "added", "removed", "changed", "fixed", "important", "features", "bug fixes", "custom generation", "server map", "teams recode"
                ]);

                const cleanLine = (line) => line
                    .replace(/&#x20;/g, " ")
                    .replace(/&amp;#x20;/g, " ")
                    .replace(/\\-/g, "-")
                    .replace(/^\s*[-*]\s+/, "")
                    .replace(/^\s*\\\s*/, "")
                    .replace(/\*\*/g, "")
                    .replace(/\\/g, "")
                    .replace(/\s+/g, " ")
                    .trim();

                const isSection = (line) => {
                    const normalized = line.replace(/:$/, "").toLowerCase();
                    return sectionNames.has(normalized) || /^[A-Z][A-Za-z ]{2,24}:$/.test(line);
                };

                document.querySelectorAll(".update-body pre").forEach((pre) => {
                    const raw = pre.textContent || "";
                    const wrapper = document.createElement("div");
                    wrapper.className = "archive-entry";

                    let currentList = null;
                    const closeList = () => {
                        currentList = null;
                    };

                    raw.split(/\r?\n/).forEach((originalLine) => {
                        const trimmedOriginal = originalLine.trim();
                        const line = cleanLine(trimmedOriginal);
                        if (!line) {
                            closeList();
                            return;
                        }

                        if (isSection(line)) {
                            closeList();
                            const heading = document.createElement("h4");
                            heading.textContent = line.replace(/:$/, "");
                            wrapper.appendChild(heading);
                            return;
                        }

                        const lookedLikeBullet = /^\s*(?:\\-|-|\*)\s*/.test(trimmedOriginal);
                        if (lookedLikeBullet || currentList) {
                            if (!currentList) {
                                currentList = document.createElement("ul");
                                wrapper.appendChild(currentList);
                            }
                            const item = document.createElement("li");
                            item.textContent = line;
                            currentList.appendChild(item);
                            return;
                        }

                        closeList();
                        const paragraph = document.createElement("p");
                        paragraph.textContent = line;
                        wrapper.appendChild(paragraph);
                    });

                    pre.replaceWith(wrapper);
                });
            })();
        </script>
    </body>
</html>
