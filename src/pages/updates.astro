---
import { Buffer } from "node:buffer";
import { gunzipSync } from "node:zlib";
import MainLayout from "../layouts/MainLayout.astro";

type UpdateEntry = {
	title: string;
	version: string;
	kind: "Update" | "Patchnote";
	lines: number;
	body: string;
};

const compressedUpdates =
	"" +
	"" +
	"";

const rawUpdates = gunzipSync(Buffer.from(compressedUpdates, "base64")).toString("utf8");

function cleanHeading(text: string) {
	return text
		.replace(/&#x20;/g, " ")
		.replace(/^\s*#+\s*/, "")
		.replace(/^\s*\*\*/, "")
		.replace(/\*\*\s*$/, "")
		.replace(/^\s*#\s*/, "")
		.replace(/\\/g, "")
		.replace(/\s+/g, " ")
		.trim();
}

function isUpdateHeading(title: string) {
	if (/^(Added|Removed|Changed|Fixed|Important|What's new|What's added|Custom Generation Has Been Added to:)$/i.test(title)) return false;
	if (/^Minecraft Update(?:\s*\(.*\))?$/i.test(title)) return false;
	return /\b(?:patchnote|update|version|verison)\b/i.test(title) || /^\d+(?:\.\d+)+\b/.test(title);
}

const headingPattern = /^#{1,6}\s*(.*)$/gm;
const headings: { title: string; index: number; end: number }[] = [];
let match: RegExpExecArray | null;
while ((match = headingPattern.exec(rawUpdates)) !== null) {
	const title = cleanHeading(match[1]);
	if (isUpdateHeading(title)) headings.push({ title, index: match.index, end: headingPattern.lastIndex });
}

const updates: UpdateEntry[] = headings.map((heading, index) => {
	const nextIndex = headings[index + 1]?.index ?? rawUpdates.length;
	const body = rawUpdates.slice(heading.end, nextIndex).trim();
	const versionMatch = heading.title.match(/(?:v(?:ersion|erison)?\s*[: ]*)?(\d+(?:\.\d+)+)/i);
	return {
		title: heading.title,
		version: versionMatch ? versionMatch[1] : heading.title,
		kind: /patchnote/i.test(heading.title) ? "Patchnote" : "Update",
		lines: body.split("\n").filter((line) => line.trim()).length,
		body,
	};
});

const totalLines = updates.reduce((sum, update) => sum + update.lines, 0);
---

<MainLayout title="Updates" description="Glitched SMP update history and patch notes.">
	<section id="updates" class="updates-page min-h-screen text-white">
		<div class="updates-backdrop"></div>
		<div class="relative z-5 mx-auto w-full max-w-6xl px-4 pt-28 pb-16">
			<div class="updates-hero grid gap-6 lg:grid-cols-[1fr_280px] lg:items-end">
				<div class="max-w-3xl">
					<p class="mb-3 inline-flex border-2 border-emerald-200/40 bg-black/45 px-3 py-2 text-xs uppercase text-emerald-100 shadow-[0_4px_0_rgba(0,0,0,0.35)] backdrop-blur font-PressStart2P">
						Full Archive
					</p>
					<h1 class="text-4xl leading-tight md:text-6xl font-PressStart2P">
						Latest Updates
					</h1>
					<p class="mt-5 text-lg leading-8 text-white/85 md:text-xl">
						Every update from the original archive, kept intact and tucked into expandable cards so the bigger posts do not eat the whole page at once.
					</p>
				</div>
				<div class="archive-stats border-2 border-emerald-100/35 bg-black/55 p-5 shadow-[0_8px_0_rgba(0,0,0,0.42)] backdrop-blur-md">
					<span class="block text-xs uppercase text-emerald-100/75 font-PressStart2P">Archive Size</span>
					<strong class="mt-3 block text-4xl text-lime-200 font-PressStart2P">{updates.length}</strong>
					<p class="mt-2 text-white/70">updates and patchnotes</p>
					<p class="mt-4 border-t border-white/10 pt-4 text-sm text-white/58">{totalLines.toLocaleString()} original content lines preserved.</p>
				</div>
			</div>

			<div class="mt-10 grid gap-4">
				{updates.map((update, index) => (
					<details class="update-card group border-2 border-white/15 bg-black/60 shadow-[0_7px_0_rgba(0,0,0,0.35)] backdrop-blur-md" open={index === 0}>
						<summary class="update-summary grid cursor-pointer gap-4 p-5 md:grid-cols-[92px_1fr_auto] md:items-center md:p-6">
							<div class="update-number text-lime-200 font-PressStart2P">#{updates.length - index}</div>
							<div>
								<div class="flex flex-wrap gap-2">
									<span class="w-max border border-cyan-200/60 bg-cyan-300/15 px-3 py-1 text-sm text-cyan-100">{update.kind}</span>
									<span class="w-max border border-amber-200/60 bg-amber-300/15 px-3 py-1 text-sm text-amber-100">{update.lines} lines</span>
								</div>
								<h2 class="mt-3 text-xl leading-8 md:text-2xl font-PressStart2P">{update.title}</h2>
							</div>
							<span class="open-label border-2 border-lime-200/50 bg-lime-300/15 px-3 py-2 text-sm text-lime-100">View full post</span>
						</summary>
						<div class="update-body border-t border-white/12 p-5 md:p-6">
							<pre class="whitespace-pre-wrap break-words leading-7 text-white/82">{update.body}</pre>
						</div>
					</details>
				))}
			</div>
		</div>
	</section>
</MainLayout>

<style>
	.updates-page {
		position: relative;
		overflow: hidden;
		background: #070b08;
	}

	.updates-page::before {
		position: fixed;
		inset: 0;
		content: "";
		background-image: url("/updates-bg.svg");
		background-size: cover;
		background-position: center;
		filter: saturate(1.1) contrast(1.08);
		transform: scale(1.04);
	}

	.updates-backdrop {
		position: fixed;
		inset: 0;
		background:
			radial-gradient(circle at 18% 14%, rgba(34, 197, 94, 0.18), transparent 24%),
			radial-gradient(circle at 84% 18%, rgba(14, 165, 233, 0.14), transparent 22%),
			linear-gradient(90deg, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.5)),
			linear-gradient(180deg, rgba(0, 0, 0, 0.22), rgba(0, 0, 0, 0.88));
	}

	.updates-hero h1 {
		color: #d9fff2;
		text-shadow:
			0 3px 0 #064e3b,
			0 6px 0 #052e16,
			0 12px 24px rgba(0, 0, 0, 0.62);
	}

	.archive-stats,
	.update-card {
		position: relative;
		overflow: hidden;
		box-shadow:
			inset 0 0 0 2px rgba(255, 255, 255, 0.1),
			0 8px 0 rgba(0, 0, 0, 0.36),
			0 18px 36px rgba(0, 0, 0, 0.3);
	}

	.update-card {
		background:
			linear-gradient(135deg, rgba(5, 28, 36, 0.92), rgba(8, 38, 24, 0.86)),
			linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px),
			linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
		background-size: auto, 22px 22px, 22px 22px;
	}

	.update-summary {
		list-style: none;
	}

	.update-summary::-webkit-details-marker {
		display: none;
	}

	.update-number {
		text-shadow: 0 3px 0 rgba(0, 0, 0, 0.7);
	}

	.open-label {
		justify-self: start;
		white-space: nowrap;
		box-shadow: 0 4px 0 rgba(0, 0, 0, 0.28);
	}

	.update-card[open] .open-label {
		background: rgba(250, 204, 21, 0.18);
		border-color: rgba(254, 240, 138, 0.62);
		color: #fef9c3;
	}

	.update-card[open] .open-label::before {
		content: "Viewing ";
	}

	.update-body pre {
		max-height: 72vh;
		overflow: auto;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(0, 0, 0, 0.28);
		padding: 1rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.95rem;
	}

	@media (max-width: 767px) {
		.open-label {
			white-space: normal;
		}
	}
</style>
