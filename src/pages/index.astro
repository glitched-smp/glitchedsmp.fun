---
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";
import GrassBlock from "../assets/blocks/grass.png";
import DirtBlock from "../assets/blocks/dirt.png";
import config from "../config.json";
---

<MainLayout>
	<section
		id="home"
		class="py-14 bg-linear-to-b from-blue-500 to-blue-300 text-white min-h-[90vh] overflow-hidden relative"
	>
		<div
			class="px-4 text-center w-[600px] md:w-[800px] top-1/2 left-1/2 -translate-1/2 absolute z-5"
		>
			<h1
				class="mb-2 md:mb-4 text-4xl md:text-6xl font-PressStart2P"
				style={{
					textShadow:
						"0 2px 0 #000, 0 4px 0 #000, 0 6px 0 rgba(0,0,0,0.7)",
				}}
			>
				Glitched SMP
			</h1>
			<span class="text-lg md:text-xl text-fg-secondary text-shadow-lg">
				{config.description}
			</span>
			<div class="grid grid-cols-3 gap-4 mt-32">
				<div class="h-30">
					<Card
						className="flex items-center justify-center h-full transition-all ease-in-out hover:scale-[1.02]"
					>
						<div class="flex flex-col gap-2">
							<span
								id="online-players-display"
								class="text-3xl font-PressStart2P"
							>
								?
							</span>
							<span>Online Players</span>
						</div>
					</Card>
				</div>
				<div class="h-30">
					<Card
						className="flex items-center justify-center h-full transition-all ease-in-out hover:scale-[1.02]"
					>
						<div class="flex flex-col gap-2">
							<span class="text-3xl font-PressStart2P">
								Empty
							</span>
							<span>Slot</span>
						</div>
					</Card>
				</div>
				<div class="h-30">
					<Card
						className="flex items-center justify-center h-full transition-all ease-in-out hover:scale-[1.02]"
					>
						<div class="flex flex-col gap-2">
							<span class="text-3xl font-PressStart2P">
								Empty
							</span>
							<span>Slot</span>
						</div>
					</Card>
				</div>
			</div>
		</div>
		<script src="../ts/clouds.ts"></script>
		<script>
			async function fetchOnlinePlayers(display: HTMLElement) {
				try {
					const res = await fetch(
						"https://api.mcsrvstat.us/3/glitchedsmp.fun",
					);

					if (!res.ok)
						throw new Error("Mcsrvstat.us is probably down");

					const data = await res.json();
					if (!data.online) return;
					display.textContent = data.players.online;
				} catch (error) {
					alert(
						error instanceof Error ? error.message : String(error),
					);
				}
			}

			document.addEventListener("DOMContentLoaded", () => {
				const onlinePlayersDisplay = document.getElementById(
					"online-players-display",
				);

				if (!onlinePlayersDisplay) return;
				fetchOnlinePlayers(onlinePlayersDisplay);
			});
		</script>
	</section>
	<section
		id="about"
		class="text-white relative"
		style={{ backgroundImage: `url(${GrassBlock.src})` }}
	>
		<div
			class="py-14 bg-linear-to-b from-transparent to-black/30 w-full h-max"
		>
			<div class="my-6 mx-auto px-4 max-w-[500px] w-full">
				<Card>
					<article>
						<h1
							class="block mb-4 text-center text-2xl text-shadow-lg font-PressStart2P"
						>
							About Us
						</h1>
						{
							config.about_us.map((line) => (
								<p class="mt-2">{line}</p>
							))
						}
					</article>
				</Card>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-4 gap-2 mx-auto w-max">
				{
					config.about_us_cards.map((card) => (
						<div>
							<Card
								color="black"
								className="transition-all ease-in-out hover:scale-[1.02]"
							>
								<h1 class="text-xl font-PressStart2P">
									{card.name}
								</h1>
								<p class="text-fg-secondary">
									{card.description}
								</p>
							</Card>
						</div>
					))
				}
			</div>
		</div>
	</section>
	<section
		id="ratings"
		class="text-white relative"
		style={{ backgroundImage: `url(${DirtBlock.src})` }}
	>
		<div
			class="py-14 bg-linear-to-b from-transparent to-black/50 w-full h-max"
		>
			<div class="pt-6 mx-auto px-4 w-max">
				<h1
					class="block mb-4 text-center text-2xl text-shadow-lg font-PressStart2P"
				>
					Ratings
				</h1>
				<div class="grid grid-cols-2 gap-2 mx-auto w-max">
					{
						config.ratings.map((rating) => (
							<Card className="flex flex-col transition-all ease-in-out hover:scale-[1.02]">
								<span class="text-xl">{rating.by}</span>
								<div
									title={`${rating.rating} out of ${config.max_rating} stars`}
									class="flex flex-col gap-0.5 text-sm"
								>
									{Array.from({
										length: Math.ceil(
											config.max_rating / 2,
										),
									}).map((_, row) => {
										const perRow = Math.ceil(
											config.max_rating / 2,
										);

										const start = row * perRow;
										return (
											<div class="flex gap-0.5">
												{Array.from({
													length: perRow,
												}).map((_, i) => {
													const index = start + i;
													if (
														index >=
														config.max_rating
													)
														return null;

													const isLighted =
														index < rating.rating;

													return (
														<span
															class={
																isLighted
																	? "text-yellow-300"
																	: "text-fg-secondary"
															}
														>
															★
														</span>
													);
												})}
											</div>
										);
									})}
								</div>
								<p class="mt-2 text-fg-muted max-w-30 md:max-w-130">
									{rating.message ??
										`${rating.rating} out of ${config.max_rating} stars`}
								</p>
							</Card>
						))
					}
				</div>
			</div>
		</div>
	</section>
</MainLayout>
