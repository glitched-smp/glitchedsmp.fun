---
import MainLayout from "../layouts/MainLayout.astro";
import Card from "../components/Card.astro";
import GrassBlock from "../assets/blocks/grass.png";
import DirtBlock from "../assets/blocks/dirt.png";
import config from "../config.json";

const serverAddress = "glitchedsmp.fun";
const updatesLink = config.public_links["/updates.html"] ? "/updates.html" : "#ratings";
const heroDescription = "A Unique Minecraft Survival Server perserving the minecraft feel while adding loads of fun topped with a great community.";
const aboutCards = [
	{
		title: "Survival First",
		description: "A survival world built around exploring, building, grinding, trading, and making your base feel like home.",
	},
	{
		title: "Custom Features",
		description: "Extra systems, quests, crates, commissions, vehicles, custom food, and server events add more to do without losing the Minecraft feel.",
	},
	{
		title: "Community Driven",
		description: "Updates are shaped by the people playing, testing, suggesting, and sticking around through each season of the server.",
	},
];
---

<MainLayout>
	<section
		id="home"
		class="home-hero py-20 text-white min-h-screen overflow-hidden relative"
	>
		<div class="sun-pixel" aria-hidden="true"></div>
		<div class="mountain mountain-back" aria-hidden="true"></div>
		<div class="mountain mountain-front" aria-hidden="true"></div>
		<div class="ground-layer ground-grass" aria-hidden="true"></div>
		<div class="ground-layer ground-dirt" aria-hidden="true"></div>

		<div
			class="relative z-5 mx-auto flex min-h-[calc(100vh-8rem)] w-full max-w-6xl flex-col justify-center px-4 pt-12 pb-28"
		>
			<div class="grid items-center gap-8 lg:grid-cols-[1.08fr_0.92fr]">
				<div class="hero-copy max-w-3xl">
					<p
						class="mb-4 inline-flex border-2 border-white/40 bg-black/30 px-3 py-2 text-xs uppercase shadow-[0_4px_0_rgba(0,0,0,0.35)] backdrop-blur font-PressStart2P"
					>
						Java Survival SMP
					</p>
					<h1
						class="mb-5 text-4xl leading-tight md:text-6xl lg:text-7xl font-PressStart2P"
					>
						Glitched SMP
					</h1>
					<p
						class="max-w-2xl text-lg leading-8 text-white/90 md:text-2xl text-shadow-lg"
					>
						{heroDescription}
					</p>

					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a
							href="#about"
							class="nolink block border-2 border-lime-200 bg-lime-500 px-5 py-4 text-center text-sm text-lime-950 shadow-[0_6px_0_#2f6f1f] transition-transform hover:-translate-y-0.5 active:translate-y-1 active:shadow-[0_2px_0_#2f6f1f] font-PressStart2P"
						>
							Start Exploring
						</a>
						<a
							href={updatesLink}
							class="nolink block border-2 border-sky-100 bg-sky-500/90 px-5 py-4 text-center text-sm text-white shadow-[0_6px_0_#155e75] transition-transform hover:-translate-y-0.5 active:translate-y-1 active:shadow-[0_2px_0_#155e75] font-PressStart2P"
						>
							Latest Updates
						</a>
					</div>
				</div>

				<div class="server-panel">
					<div
						class="border-2 border-white/30 bg-black/35 p-4 shadow-[0_8px_0_rgba(0,0,0,0.35)] backdrop-blur-md md:p-5"
					>
						<div
							class="mb-4 flex items-center justify-between gap-3 border-b border-white/20 pb-3"
						>
							<span class="text-sm uppercase text-white/70 font-PressStart2P">
								Server Status
							</span>
							<span
								id="server-status-display"
								class="border border-emerald-200/70 bg-emerald-400/20 px-2 py-1 text-xs text-emerald-100"
							>
								Checking
							</span>
						</div>

						<div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
							<Card
								className="hero-stat flex min-h-28 items-center justify-center text-center transition-all ease-in-out hover:scale-[1.02]"
							>
								<div class="flex flex-col gap-2">
									<span
										id="online-players-display"
										class="text-2xl md:text-3xl font-PressStart2P"
									>
										?
									</span>
									<span class="text-sm text-white/80">Online Players</span>
								</div>
							</Card>
							<Card
								className="hero-stat flex min-h-28 items-center justify-center text-center transition-all ease-in-out hover:scale-[1.02]"
							>
								<div class="flex flex-col gap-2">
									<span class="text-xl md:text-2xl font-PressStart2P">
										SMP
									</span>
									<span class="text-sm text-white/80">Survival World</span>
								</div>
							</Card>
							<Card
								className="hero-stat flex min-h-28 items-center justify-center text-center transition-all ease-in-out hover:scale-[1.02]"
							>
								<div class="flex flex-col gap-2">
									<span class="text-xl md:text-2xl font-PressStart2P">
										1.21+
									</span>
									<span class="text-sm text-white/80">Minecraft Ready</span>
								</div>
							</Card>
						</div>

						<div class="mt-4 border-2 border-white/25 bg-black/30 p-3">
							<span class="mb-2 block text-xs uppercase text-white/60 font-PressStart2P">
								Join IP
							</span>
							<div
								class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
							>
								<code
									id="server-address"
									class="break-all text-lg text-lime-200 md:text-xl"
								>
									{serverAddress}
								</code>
								<button
									id="copy-server-address"
									type="button"
									class="border-2 border-white/30 bg-white/15 px-3 py-2 text-sm text-white transition hover:bg-white/25 active:scale-95"
								>
									Copy
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script src="../ts/clouds.ts"></script>
		<script>
			async function fetchOnlinePlayers(
				display: HTMLElement,
				statusDisplay: HTMLElement | null,
			) {
				try {
					const res = await fetch(
						"https://api.mcsrvstat.us/3/glitchedsmp.fun",
					);

					if (!res.ok)
						throw new Error("Mcsrvstat.us is probably down");

					const data = await res.json();
					if (!data.online) {
						display.textContent = "0";
						if (statusDisplay) {
							statusDisplay.textContent = "Offline";
							statusDisplay.className =
								"border border-red-200/70 bg-red-400/20 px-2 py-1 text-xs text-red-100";
						}
						return;
					}

					display.textContent = data.players.online;
					if (statusDisplay) {
						statusDisplay.textContent = "Online";
						statusDisplay.className =
							"border border-emerald-200/70 bg-emerald-400/20 px-2 py-1 text-xs text-emerald-100";
					}
				} catch {
					display.textContent = "?";
					if (statusDisplay) {
						statusDisplay.textContent = "Unknown";
						statusDisplay.className =
							"border border-yellow-200/70 bg-yellow-400/20 px-2 py-1 text-xs text-yellow-100";
					}
				}
			}

			document.addEventListener("DOMContentLoaded", () => {
				const onlinePlayersDisplay = document.getElementById(
					"online-players-display",
				);
				const statusDisplay = document.getElementById(
					"server-status-display",
				);
				const copyButton = document.getElementById("copy-server-address");
				const serverAddress = document.getElementById("server-address");

				if (onlinePlayersDisplay)
					fetchOnlinePlayers(onlinePlayersDisplay, statusDisplay);

				copyButton?.addEventListener("click", async () => {
					const address = serverAddress?.textContent?.trim();
					if (!address) return;
					await navigator.clipboard.writeText(address);
					copyButton.textContent = "Copied";
					setTimeout(() => {
						copyButton.textContent = "Copy";
					}, 1600);
				});
			});
		</script>
	</section>

	<section
		id="about"
		class="about-section relative overflow-hidden text-white"
		style={{ backgroundImage: `url(${GrassBlock.src})` }}
	>
		<div class="relative z-5 mx-auto grid max-w-6xl gap-8 px-4 py-20 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
			<div>
				<p class="mb-4 inline-flex border-2 border-lime-200/40 bg-black/35 px-3 py-2 text-xs uppercase text-lime-100 shadow-[0_4px_0_rgba(0,0,0,0.35)] font-PressStart2P">
					About Us
				</p>
				<h2 class="text-3xl leading-tight md:text-5xl font-PressStart2P">
					Built Like Minecraft, Tuned For More
				</h2>
				<p class="mt-5 text-lg leading-8 text-white/85">
					Glitched SMP is a survival server focused on keeping that classic Minecraft loop alive while adding custom systems, seasonal ideas, and community-shaped updates that give players more reasons to keep exploring.
				</p>
			</div>

			<div class="grid gap-4 md:grid-cols-3">
				{aboutCards.map((card) => (
					<article class="about-card border-2 border-white/15 bg-black/45 p-5 shadow-[0_7px_0_rgba(0,0,0,0.35)] backdrop-blur-md transition-transform hover:-translate-y-1">
						<h3 class="text-lg font-PressStart2P">{card.title}</h3>
						<p class="mt-4 leading-7 text-white/78">{card.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section
		id="ratings"
		class="ratings-section relative overflow-hidden text-white"
		style={{ backgroundImage: `url(${DirtBlock.src})` }}
	>
		<div class="relative z-5 mx-auto max-w-6xl px-4 py-20">
			<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
				<div>
					<p class="mb-4 inline-flex border-2 border-amber-200/40 bg-black/35 px-3 py-2 text-xs uppercase text-amber-100 shadow-[0_4px_0_rgba(0,0,0,0.35)] font-PressStart2P">
						Player Ratings
					</p>
					<h2 class="text-3xl leading-tight md:text-5xl font-PressStart2P">
						What Players Say
					</h2>
				</div>
				<p class="max-w-xl text-white/75 md:text-right">
					Reviews from people who have played, tested, and lived through the chaos with us.
				</p>
			</div>

			<div class="mt-8 grid gap-4 md:grid-cols-2">
				{config.ratings.map((rating) => (
					<article class="rating-card border-2 border-white/15 bg-black/50 p-5 shadow-[0_7px_0_rgba(0,0,0,0.35)] backdrop-blur-md transition-transform hover:-translate-y-1">
						<div class="flex items-start justify-between gap-4">
							<h3 class="text-xl font-PressStart2P">{rating.by}</h3>
							<span class="border border-yellow-200/60 bg-yellow-300/15 px-3 py-1 text-sm text-yellow-100">
								{rating.rating}/{config.max_rating}
							</span>
						</div>
						<div class="mt-4 flex flex-wrap gap-1 text-lg" title={`${rating.rating} out of ${config.max_rating} stars`}>
							{Array.from({ length: config.max_rating }).map((_, index) => (
								<span class={index < rating.rating ? "text-yellow-300" : "text-white/20"}>★</span>
							))}
						</div>
						<p class="mt-4 leading-7 text-white/76">
							{rating.message ?? `${rating.rating} out of ${config.max_rating} stars`}
						</p>
					</article>
				))}
			</div>
		</div>
	</section>
</MainLayout>

<style>
	.home-hero {
		background:
			linear-gradient(180deg, rgba(74, 170, 255, 0.95) 0%, rgba(75, 184, 255, 0.82) 45%, rgba(39, 126, 91, 0.9) 100%),
			repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.08) 0 2px, transparent 2px 24px);
	}

	.home-hero::before {
		position: absolute;
		inset: 0;
		content: "";
		background:
			linear-gradient(rgba(255, 255, 255, 0.08) 2px, transparent 2px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.08) 2px, transparent 2px);
		background-size: 32px 32px;
		mask-image: linear-gradient(to bottom, black, transparent 72%);
		pointer-events: none;
	}

	.home-hero::after,
	.about-section::before,
	.ratings-section::before {
		position: absolute;
		inset: 0;
		content: "";
		pointer-events: none;
	}

	.home-hero::after {
		inset: auto 0 0;
		height: 36%;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent);
	}

	.about-section,
	.ratings-section {
		background-size: 64px 64px;
		image-rendering: pixelated;
	}

	.about-section::before {
		background:
			linear-gradient(135deg, rgba(11, 54, 24, 0.82), rgba(0, 0, 0, 0.42)),
			linear-gradient(to bottom, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.5));
	}

	.ratings-section::before {
		background:
			linear-gradient(135deg, rgba(50, 29, 13, 0.86), rgba(0, 0, 0, 0.55)),
			linear-gradient(to bottom, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.64));
	}

	.hero-copy h1,
	.about-section h2,
	.ratings-section h2 {
		color: #fff7b8;
		text-shadow:
			0 3px 0 #5d370b,
			0 6px 0 #2d1a08,
			0 10px 18px rgba(0, 0, 0, 0.55);
	}

	.server-panel {
		filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.35));
	}

	.hero-stat,
	.about-card,
	.rating-card {
		box-shadow:
			inset 0 0 0 2px rgba(255, 255, 255, 0.12),
			0 6px 0 rgba(0, 0, 0, 0.28);
	}

	.sun-pixel {
		position: absolute;
		top: 90px;
		right: 11%;
		width: 96px;
		aspect-ratio: 1;
		background: #ffd86b;
		box-shadow:
			0 0 0 10px rgba(255, 216, 107, 0.22),
			0 0 42px rgba(255, 216, 107, 0.75);
	}

	.mountain {
		position: absolute;
		right: -8%;
		bottom: 120px;
		width: min(64vw, 780px);
		aspect-ratio: 2.6 / 1;
		clip-path: polygon(0 100%, 14% 52%, 26% 72%, 42% 18%, 58% 66%, 70% 34%, 100% 100%);
	}

	.mountain-back {
		right: 18%;
		bottom: 190px;
		background: rgba(75, 117, 86, 0.38);
	}

	.mountain-front {
		background: rgba(38, 91, 55, 0.55);
	}

	.ground-layer {
		position: absolute;
		right: 0;
		left: 0;
		background-size: 64px 64px;
		image-rendering: pixelated;
	}

	.ground-grass {
		bottom: 56px;
		height: 72px;
		background-image: url("../assets/blocks/grass.png");
		box-shadow: 0 -14px 36px rgba(0, 0, 0, 0.18);
	}

	.ground-dirt {
		bottom: 0;
		height: 64px;
		background-image: url("../assets/blocks/dirt.png");
	}

	@media (max-width: 767px) {
		.sun-pixel {
			top: 88px;
			right: 24px;
			width: 58px;
		}

		.mountain {
			width: 120vw;
			bottom: 132px;
		}
	}
</style>
