---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Terms of Service" description="Glitched Network terms of service.">
    <main class="legal-page">
        <article>
            <h1 class="font-PressStart2P">Terms of Service</h1>
            <p>By using the Glitched Network website, Discord, or Minecraft server, you agree to follow the server rules and respect staff decisions.</p>

            <h2 class="font-PressStart2P">Player Conduct</h2>
            <p>Do not cheat, exploit bugs, harass players, threaten others, spam, impersonate staff, or intentionally damage the community.</p>

            <h2 class="font-PressStart2P">Staff Actions</h2>
            <p>Staff may warn, mute, kick, ban, rollback, or remove content when needed to protect the server and its players.</p>

            <h2 class="font-PressStart2P">Changes</h2>
            <p>Rules, features, events, and policies may change as the server grows.</p>
        </article>
    </main>
</MainLayout>
